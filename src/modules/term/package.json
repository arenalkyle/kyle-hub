{
  "name": "kyle-term",
  "version": "0.1.0",
  "description": "Obsidian terminal plugin built for AI coding agents",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
