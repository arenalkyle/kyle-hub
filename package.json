{
  "name": "kyle-hub",
  "version": "0.1.0",
  "description": "One Obsidian plugin: tickets, terminals, logs, retros, brain",
  "private": true,
  "license": "MIT",
  "bin": {
    "kh": "bin/kh.js",
    "kt": "bin/kt.js"
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "check-size": "node scripts/check-size.mjs",
    "smoke": "node scripts/cdp-smoke.mjs",
    "smoke:triage": "node scripts/cdp-triage-smoke.mjs",
    "smoke:launch": "node scripts/cdp-launch-smoke.mjs",
    "smoke:session-end": "node scripts/cdp-session-end-smoke.mjs",
    "smoke:retro": "node scripts/cdp-retro-smoke.mjs",
    "smoke:promote": "node scripts/cdp-promote-smoke.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lydell/node-pty": "^1.1.0",
    "diff": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@eslint/js": "^9.0.0",
    "@lezer/common": "^1.5.6",
    "@types/diff": "^5.2.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "obsidian": "latest",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
